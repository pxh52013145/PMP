{
  "id": "aurora-grid",
  "name": "Aurora Grid",
  "author": "PMP Docs",
  "version": "1.0.0",
  "description": "Example theme pack written against the public binding-first skin contract.",
  "tokens": {
    "color": {
      "bg.canvas": "#070b16",
      "bg.surface": "#11182d",
      "bg.overlay": "rgba(5, 10, 23, 0.76)",
      "fg.default": "#ecf6ff",
      "fg.muted": "#9cb0c9",
      "border.default": "rgba(126, 211, 255, 0.22)",
      "accent.primary": "#67e8f9",
      "accent.secondary": "#a78bfa",
      "accent.danger": "#fb7185"
    },
    "motion": {
      "duration.fast": 140,
      "duration.normal": 220
    },
    "radius": {
      "control.md": 12,
      "panel.lg": 20
    },
    "space": {
      "control.md": 12,
      "panel.lg": 20
    },
    "shadow": {
      "surface.glow": "0 18px 60px rgba(56, 189, 248, 0.18)"
    }
  },
  "pixel": {
    "shape": "circle",
    "size": 1,
    "opacity": 1,
    "colors": {
      "default": { "slot": "primary", "alpha": 0.6 },
      "hover": { "slot": "accent", "state": "hover" },
      "active": { "slot": "primary", "state": "active" },
      "occupied": { "slot": "secondary", "alpha": 0.3 }
    }
  },
  "background": {
    "maximized": {
      "type": "color",
      "color": "#070b16",
      "opacity": 1
    },
    "windowed": {
      "type": "color",
      "color": "#070b16",
      "opacity": 1
    }
  },
  "fonts": {
    "primary": "IBM Plex Sans, sans-serif"
  },
  "surfaces": {
    "page.settings.aurora": {
      "parts": {
        "root": {
          "style": {
            "background": "linear-gradient(180deg, rgba(17, 24, 45, 0.98), rgba(9, 14, 30, 0.96))",
            "border": "1px solid rgba(126, 211, 255, 0.16)",
            "boxShadow": "0 18px 60px rgba(56, 189, 248, 0.12)"
          }
        },
        "shell": {
          "style": {
            "backdropFilter": "blur(18px)"
          }
        },
        "header": {
          "style": {
            "borderBottom": "1px solid rgba(126, 211, 255, 0.12)"
          }
        },
        "divider": {
          "style": {
            "background": "rgba(126, 211, 255, 0.12)"
          }
        },
        "subbar": {
          "style": {
            "background": "rgba(7, 11, 22, 0.42)"
          }
        }
      }
    },
    "page.settings.main-tab.aurora": {
      "parts": {
        "root": {
          "style": {
            "border": "1px solid rgba(126, 211, 255, 0.14)",
            "background": "rgba(17, 24, 45, 0.7)",
            "borderRadius": 999,
            "color": "#ecf6ff"
          }
        }
      },
      "states": {
        "active": {
          "style": {
            "background": "linear-gradient(135deg, rgba(103, 232, 249, 0.22), rgba(167, 139, 250, 0.18))",
            "boxShadow": "0 0 0 1px rgba(103, 232, 249, 0.18) inset"
          }
        }
      }
    },
    "page.settings.sub-tab.aurora": {
      "parts": {
        "root": {
          "style": {
            "borderRadius": 999,
            "color": "#9cb0c9"
          }
        }
      },
      "states": {
        "active": {
          "style": {
            "color": "#ecf6ff",
            "background": "rgba(103, 232, 249, 0.12)"
          }
        }
      }
    },
    "page.music-library.aurora": {
      "parts": {
        "root": {
          "style": {
            "background": "linear-gradient(180deg, rgba(9, 14, 30, 0.98), rgba(6, 10, 23, 0.96))"
          }
        },
        "header": {
          "style": {
            "borderBottom": "1px solid rgba(126, 211, 255, 0.12)"
          }
        },
        "toolbar": {
          "style": {
            "background": "rgba(17, 24, 45, 0.68)",
            "backdropFilter": "blur(14px)",
            "border": "1px solid rgba(126, 211, 255, 0.12)",
            "borderRadius": 18
          }
        },
        "toolbar-region": {
          "style": {
            "paddingTop": 12,
            "paddingBottom": 12
          }
        }
      }
    },
    "overlay.modal.aurora": {
      "parts": {
        "overlay": {
          "style": {
            "background": "rgba(2, 6, 23, 0.74)",
            "backdropFilter": "blur(10px)"
          }
        }
      }
    },
    "overlay.confirm-dialog.aurora": {
      "parts": {
        "container": {
          "style": {
            "background": "linear-gradient(180deg, rgba(17, 24, 45, 0.98), rgba(9, 14, 30, 0.96))",
            "border": "1px solid rgba(126, 211, 255, 0.16)",
            "boxShadow": "0 18px 60px rgba(56, 189, 248, 0.14)"
          }
        },
        "title": {
          "style": {
            "color": "#ecf6ff",
            "letterSpacing": "0.02em"
          }
        },
        "confirmButton": {
          "style": {
            "background": "linear-gradient(135deg, #22d3ee, #60a5fa)",
            "color": "#08111f"
          }
        },
        "cancelButton": {
          "style": {
            "background": "rgba(255, 255, 255, 0.04)",
            "color": "#ecf6ff"
          }
        }
      }
    },
    "overlay.context-menu.aurora": {
      "parts": {
        "container": {
          "style": {
            "background": "rgba(12, 18, 35, 0.96)",
            "border": "1px solid rgba(126, 211, 255, 0.14)",
            "boxShadow": "0 18px 60px rgba(56, 189, 248, 0.16)"
          }
        },
        "item": {
          "style": {
            "borderRadius": 10
          }
        },
        "divider": {
          "style": {
            "background": "rgba(126, 211, 255, 0.12)"
          }
        }
      },
      "states": {
        "danger": {
          "parts": {
            "item": {
              "style": {
                "color": "#fb7185"
              }
            }
          }
        }
      }
    },
    "primitive.button.aurora-primary": {
      "parts": {
        "root": {
          "style": {
            "background": "linear-gradient(135deg, #22d3ee, #60a5fa)",
            "color": "#08111f",
            "border": "1px solid rgba(126, 211, 255, 0.26)",
            "boxShadow": "0 10px 28px rgba(56, 189, 248, 0.18)"
          }
        }
      }
    },
    "primitive.card.aurora-settings": {
      "parts": {
        "root": {
          "style": {
            "background": "rgba(17, 24, 45, 0.76)",
            "border": "1px solid rgba(126, 211, 255, 0.14)",
            "borderRadius": 20,
            "boxShadow": "0 18px 60px rgba(56, 189, 248, 0.12)"
          }
        }
      }
    },
    "primitive.dialog.aurora": {
      "parts": {
        "root": {
          "style": {
            "background": "linear-gradient(180deg, rgba(17, 24, 45, 0.98), rgba(9, 14, 30, 0.96))",
            "border": "1px solid rgba(126, 211, 255, 0.16)",
            "borderRadius": 22,
            "boxShadow": "0 22px 80px rgba(56, 189, 248, 0.18)"
          }
        },
        "title": {
          "style": {
            "color": "#ecf6ff",
            "letterSpacing": "0.02em"
          }
        },
        "footer": {
          "style": {
            "borderTop": "1px solid rgba(126, 211, 255, 0.1)"
          }
        }
      }
    }
  },
  "bindings": {
    "page.settings": {
      "surface": "page.settings.aurora"
    },
    "page.settings.main-tab": {
      "surface": "page.settings.main-tab.aurora"
    },
    "page.settings.sub-tab": {
      "surface": "page.settings.sub-tab.aurora"
    },
    "page.music-library": {
      "surface": "page.music-library.aurora"
    },
    "overlay.modal": {
      "surface": "overlay.modal.aurora"
    },
    "overlay.confirm-dialog": {
      "surface": "overlay.confirm-dialog.aurora"
    },
    "overlay.context-menu": {
      "surface": "overlay.context-menu.aurora"
    },
    "primitive.button.primary": {
      "surface": "primitive.button.aurora-primary"
    },
    "primitive.card.settings": {
      "surface": "primitive.card.aurora-settings"
    },
    "primitive.dialog.default": {
      "surface": "primitive.dialog.aurora"
    },
    "magnet.track-info": {
      "variant": "minimal",
      "props": {
        "layout": "compact"
      },
      "capabilities": {
        "dynamicColor": {
          "enabled": true,
          "source": "cover",
          "mode": "gradient",
          "apply": "blend",
          "blendRatio": 0.28
        }
      }
    },
    "magnet.btn-play-pause": {
      "variant": "cyber"
    },
    "magnet.progress-bar": {
      "capabilities": {
        "dynamicColor": {
          "enabled": true,
          "source": "cover",
          "mode": "gradient",
          "apply": "full"
        }
      }
    }
  }
}
