{
    "build":  {
                  "beforeDevCommand":  "pnpm run dev:vite",
                  "beforeBuildCommand":  "pnpm run build:vite",
                  "devPath":  "http://localhost:1420",
                  "distDir":  "../dist",
                  "withGlobalTauri":  false
              },
    "package":  {
                    "productName":  "Pixel Matrix Player"
                },
    "tauri":  {
                  "windows":  [
                                  {
                                      "label":  "main",
                                      "fullscreen":  false,
                                      "resizable":  true,
                                      "title":  "Pixel Matrix Player",
                                      "width":  972,
                                      "height":  720,
                                      "minWidth":  526,
                                      "minHeight":  400,
                                      "transparent":  false,
                                      "decorations":  false,
                                      "alwaysOnTop":  false,
                                      "fileDropEnabled":  false
                                  }
                              ]
              }
}
