{
  "build": {
    "beforeDevCommand": "pnpm run dev:vite:tauri",
    "beforeBuildCommand": "pnpm run build:vite:tauri",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Pixel Matrix Player",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "protocol": {
        "all": false,
        "asset": true,
          "assetScope": [
            "$APPDATA/background-media/*",
            "$APPDATA/background-media/**",
            "$APPDATA/music-covers/*",
            "$APPDATA/music-covers/**",
            "$APPDATA/pmp-durable/extensions-v2/*",
            "$APPDATA/pmp-durable/extensions-v2/**",
            "$APPLOCALDATA/music-covers/*",
            "$APPLOCALDATA/music-covers/**",
            "$APPCACHE/music-covers/*",
            "$APPCACHE/music-covers/**"
          ]
        },
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": true
      },
      "dialog": {
        "all": false,
        "open": false,
        "save": false,
        "message": false,
        "ask": false,
        "confirm": false
      },
      "fs": {
        "all": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.pixelmatrix.player",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Pixel Matrix Player"
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Pixel Matrix Player",
        "width": 972,
        "height": 720,
        "minWidth": 526,
        "minHeight": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "fileDropEnabled": false
      }
    ]
  }
}
