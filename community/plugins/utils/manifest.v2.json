{
  "schemaVersion": "2.0",
  "kind": "extension",
  "identity": {
    "id": "utils",
    "publisher": "pixel-matrix.dev",
    "version": "0.1.0",
    "name": "utils",
    "displayName": "Utils",
    "description": "SAO Utils-inspired hybrid fixture combining a host-managed magnet hub, ambient shell surfaces, and a native-style sidecar probe lane.",
    "keywords": ["utils", "magnet", "shell-surface", "sidecar", "desktop-tools"],
    "categories": ["demo", "desktop", "tooling"]
  },
  "hostTargets": [
    {
      "hostId": "pmp",
      "required": true
    }
  ],
  "runtimes": [
    {
      "runtimeId": "webview.main",
      "kind": "webview",
      "entry": "index.js",
      "priority": 40,
      "bridge": "pxp.runtime.bridge.v1",
      "dataPlane": {
        "kinds": ["inline-json"]
      }
    },
    {
      "runtimeId": "sidecar.main",
      "kind": "sidecar",
      "entry": "bin/utils-sidecar.js",
      "priority": 30,
      "sandbox": "native",
      "bridge": "pxp.runtime.bridge.v1",
      "dataPlane": {
        "kinds": ["pipe"]
      }
    }
  ],
  "activationEvents": [
    "onView:utils",
    "onView:utils-page",
    "onView:utils-overlay",
    "onView:utils-widget",
    "onCommand:utils.probe.system",
    "onCommand:utils.probe.windows",
    "onCommand:utils.simulate.hang",
    "onCommand:utils.simulate.crash"
  ],
  "requiresCapabilities": [
    {
      "capabilityId": "core.capability-registry"
    }
  ],
  "optionalCapabilities": [
    {
      "capabilityId": "host.pmp.navigation"
    },
    {
      "capabilityId": "host.pmp.storage.config"
    },
    {
      "capabilityId": "host.pmp.shell.window"
    },
    {
      "capabilityId": "host.pmp.magnets.catalog"
    },
    {
      "capabilityId": "host.pmp.magnets.layout"
    },
    {
      "capabilityId": "host.pmp.magnets.renderer"
    }
  ],
  "contributes": {
    "core": {
      "commands": [
        {
          "kind": "command",
          "id": "utils.probe.system",
          "title": "Utils: Probe System",
          "description": "Run the sidecar system probe and snapshot visible host capabilities."
        },
        {
          "kind": "command",
          "id": "utils.probe.windows",
          "title": "Utils: Probe Windows",
          "description": "Run the sidecar shell-window probe against the host-managed desktop bridge."
        },
        {
          "kind": "command",
          "id": "utils.simulate.hang",
          "title": "Utils: Simulate Sidecar Hang",
          "description": "Hold runtime activation to validate unresponsive detection and forced teardown."
        },
        {
          "kind": "command",
          "id": "utils.simulate.crash",
          "title": "Utils: Simulate Sidecar Crash",
          "description": "Emit a fatal runtime error after activation to validate crash cleanup."
        }
      ]
    },
    "host": {
      "pmp": {
        "pages": [
          {
            "kind": "page",
            "id": "utils-page",
            "title": "Utils Page",
            "description": "Expanded SAO-inspired detail view for host capability, shell surface, and sidecar diagnostics.",
            "group": "plugins",
            "order": 150
          }
        ],
        "shellSurfaces": [
          {
            "kind": "shell-surface",
            "id": "utils-overlay",
            "title": "Utils Overlay",
            "description": "Quick ambient panel mounted through the host overlay window chain.",
            "surfaceType": "overlay",
            "width": 520,
            "height": 340,
            "pointerPolicy": "capture-input",
            "focusable": true,
            "dismissOnEscape": true
          },
          {
            "kind": "shell-surface",
            "id": "utils-widget",
            "title": "Utils Widget",
            "description": "Desktop widget surface for HUD-like status and last probe summary.",
            "surfaceType": "desktop-widget",
            "width": 380,
            "height": 220,
            "pointerPolicy": "capture-input",
            "focusable": true,
            "dismissOnEscape": false
          }
        ],
        "magnets": {
          "defaultAnchor": {
            "type": "range",
            "coordinates": [
              { "x": 0, "y": 0 },
              { "x": 3, "y": 2 }
            ]
          },
          "defaultStyle": {
            "width": "100%",
            "height": "100%",
            "backgroundColor": "rgba(7, 15, 28, 0.78)",
            "borderRadius": "14px",
            "padding": "12px",
            "border": "1px solid rgba(120, 223, 255, 0.22)"
          },
          "defaultVariant": "hub",
          "variants": [
            {
              "id": "hub",
              "label": "Hub",
              "description": "Primary SAO-like dashboard for shell surfaces, host capabilities, and sidecar status."
            },
            {
              "id": "compact",
              "label": "Compact",
              "description": "Denser chrome for tighter matrix footprints and HUD-style layouts."
            }
          ]
        }
      }
    }
  }
}
