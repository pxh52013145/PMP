{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["apps/desktop/src/kernel/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/components/**",
                  "**/contexts/**",
                  "**/services/**",
                  "**/magnet-system/**",
                  "**/shader-system/**",
                  "**/themes/**",
                  "**/modules/**",
                  "**/utils/**",
                  "**/pixelEngine/**"
                ],
                "message": "Kernel must not depend on UI/features; expose capabilities via ServiceRegistry/EventBus/ContributionRegistry and contracts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/services/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/components/**",
                  "**/contexts/**",
                  "**/magnet-system/**",
                  "**/shader-system/**",
                  "**/themes/**"
                ],
                "message": "Services must not import UI/features (components/contexts/magnet-system/shader-system/themes). Keep services UI-agnostic and communicate via registry/events."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/magnet-system/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/shader-system/**"],
                "message": "Feature boundary: magnet-system must not depend on shader-system; communicate via contracts/services/events if needed."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/shader-system/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/magnet-system/**"],
                "message": "Feature boundary: shader-system must not depend on magnet-system; communicate via contracts/services/events if needed."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/desktop/src/magnet-system/registry.tsx",
        "apps/desktop/src/magnet-system/variantRegistry.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/components/**", "**/contexts/**"],
                "message": "Registries must stay pure (no UI imports). Register builtins via builtin modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/modules/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/components/**", "**/contexts/**"],
                "message": "Modules must not import UI (components/contexts). Keep modules reusable and UI-agnostic."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/contracts/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/components/**", "**/contexts/**"],
                "message": "Contracts must stay UI-agnostic (no components/contexts imports)."
              }
            ]
          }
        ]
      }
    }
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
